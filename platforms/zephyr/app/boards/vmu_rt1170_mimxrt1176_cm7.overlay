/* Sensor orientation and serial ports as in boards/px4/fmu-v6xrt/init/rc.board_sensors, the SD card and CAN buses */

#include <dt-bindings/px4/rotation.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	px4-sensors {
		compatible = "px4,sensors";

		imu0 {
			sensor = <&icm42686_0>;
			type = "imu";
			rotation = <PX4_ROTATION_PITCH_180>;
		};

		imu1 {
			sensor = <&icm42688_0>;
			type = "imu";
			rotation = <PX4_ROTATION_YAW_270>;
		};

		accel2 {
			sensor = <&bmi08x_accel>;
			type = "accel";
			rotation = <PX4_ROTATION_YAW_180>;
		};

		gyro2 {
			sensor = <&bmi08x_gyro>;
			type = "gyro";
			rotation = <PX4_ROTATION_YAW_180>;
		};

		mag0 {
			sensor = <&ist8310>;
			type = "mag";
			rotation = <PX4_ROTATION_ROLL_180_YAW_90>;
			external;
		};

		mag1 {
			sensor = <&bmm150>;
			type = "mag";
		};

		mag2 {
			sensor = <&rm3100>;
			type = "mag";
			external;
		};

		mag3 {
			sensor = <&lis3mdl>;
			type = "mag";
			external;
		};

		baro0 {
			sensor = <&bmp388_0>;
			type = "baro";
		};

		baro1 {
			sensor = <&bmp388_1>;
			type = "baro";
		};

		power1-ina226 {
			sensor = <&power1_ina226>;
			type = "power";
			battery = <1>;
		};

		power1-ina228 {
			sensor = <&power1_ina228>;
			type = "power";
			battery = <1>;
		};

		power2-ina226 {
			sensor = <&power2_ina226>;
			type = "power";
			battery = <2>;
		};

		power2-ina228 {
			sensor = <&power2_ina228>;
			type = "power";
			battery = <2>;
		};

		power1-smart-battery {
			sensor = <&power1_sbs>;
			type = "fuel-gauge";
			battery = <1>;
		};

		power2-smart-battery {
			sensor = <&power2_sbs>;
			type = "fuel-gauge";
			battery = <2>;
		};
	};

	/* lpuart6 is the RC input, read by the futaba,sbus input driver */
	px4-serial-ports {
		compatible = "px4,serial-ports";

		gps1 {
			uart = <&lpuart3>;
			path = "/dev/ttyS1";
		};

		telem1 {
			uart = <&lpuart4>;
			path = "/dev/ttyS2";
		};

		gps2 {
			uart = <&lpuart5>;
			path = "/dev/ttyS3";
		};

		telem2 {
			uart = <&lpuart8>;
			path = "/dev/ttyS5";
		};

		telem3 {
			uart = <&lpuart10>;
			path = "/dev/ttyS6";
		};

		ext2 {
			uart = <&lpuart11>;
			path = "/dev/ttyS7";
		};

		usb {
			uart = <&cdc_acm_uart0>;
			path = "/dev/ttyACM0";
		};
	};

	px4-can-buses {
		compatible = "px4,can-buses";

		can1 {
			can = <&flexcan1>;
		};

		can2 {
			can = <&flexcan2>;
		};

		can3 {
			can = <&flexcan3>;
		};
	};

	/*
	 * FMU_CH1 to FMU_CH8 of FMU-v6XRT (boards/px4/fmu-v6xrt/src/timer_config.cpp), at 400 Hz. The
	 * nxp,prescaler of the board limits the period to 17 ms.
	 */
	px4-pwm-outputs {
		compatible = "px4,pwm-outputs";

		main1 {
			pwms = <&flexpwm1_pwm0 0 PWM_HZ(400) PWM_POLARITY_NORMAL>;
		};

		main2 {
			pwms = <&flexpwm1_pwm1 0 PWM_HZ(400) PWM_POLARITY_NORMAL>;
		};

		main3 {
			pwms = <&flexpwm1_pwm2 0 PWM_HZ(400) PWM_POLARITY_NORMAL>;
		};

		main4 {
			pwms = <&flexpwm2_pwm0 0 PWM_HZ(400) PWM_POLARITY_NORMAL>;
		};

		main5 {
			pwms = <&flexpwm2_pwm1 0 PWM_HZ(400) PWM_POLARITY_NORMAL>;
		};

		main6 {
			pwms = <&flexpwm2_pwm2 0 PWM_HZ(400) PWM_POLARITY_NORMAL>;
		};

		main7 {
			pwms = <&flexpwm2_pwm3 0 PWM_HZ(400) PWM_POLARITY_NORMAL>;
		};

		main8 {
			pwms = <&flexpwm3_pwm0 0 PWM_HZ(400) PWM_POLARITY_NORMAL>;
		};
	};

	/* the 16 channels of the SBUS receiver of the board, as with NuttX */
	px4-rc-input {
		compatible = "px4,rc-input";
		input = <&sbus>;
		channels = <INPUT_EV_ABS INPUT_ABS_RX>,
			   <INPUT_EV_ABS INPUT_ABS_RY>,
			   <INPUT_EV_ABS INPUT_ABS_Y>,
			   <INPUT_EV_ABS INPUT_ABS_X>,
			   <INPUT_EV_MSC 5>,
			   <INPUT_EV_MSC 6>,
			   <INPUT_EV_MSC 7>,
			   <INPUT_EV_MSC 8>,
			   <INPUT_EV_MSC 9>,
			   <INPUT_EV_MSC 10>,
			   <INPUT_EV_MSC 11>,
			   <INPUT_EV_MSC 12>,
			   <INPUT_EV_MSC 13>,
			   <INPUT_EV_MSC 14>,
			   <INPUT_EV_MSC 15>,
			   <INPUT_EV_MSC 16>;
	};

	fstab {
		compatible = "zephyr,fstab";

		sd {
			compatible = "zephyr,fstab,fatfs";
			mount-point = "/SD:";
			automount;
			disk-access;
		};
	};
};

/*
 * the sticks of the board on SBUS channels 1 to 4, and channels 5 to 16 as raw values, with the
 * channel as code, instead of the kill switch key of the board on channel 5, which has no middle
 * position
 */
&lpuart6 {
	sbus: sbus {
		kill_switch {
			type = <INPUT_EV_MSC>;
			zephyr,code = <5>;
		};

		channel-6 {
			channel = <6>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <6>;
		};

		channel-7 {
			channel = <7>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <7>;
		};

		channel-8 {
			channel = <8>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <8>;
		};

		channel-9 {
			channel = <9>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <9>;
		};

		channel-10 {
			channel = <10>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <10>;
		};

		channel-11 {
			channel = <11>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <11>;
		};

		channel-12 {
			channel = <12>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <12>;
		};

		channel-13 {
			channel = <13>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <13>;
		};

		channel-14 {
			channel = <14>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <14>;
		};

		channel-15 {
			channel = <15>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <15>;
		};

		channel-16 {
			channel = <16>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <16>;
		};
	};
};

/*
 * compasses of GPS modules on GPS1, and the power module or smart battery on POWER1, used if
 * they respond
 */
&lpi2c1 {
	rm3100: rm3100@20 {
		compatible = "pni,rm3100";
		reg = <0x20>;
		zephyr,deferred-init;
	};

	lis3mdl: lis3mdl@1e {
		compatible = "st,lis3mdl-magn";
		reg = <0x1e>;
		zephyr,deferred-init;
	};

	power1_ina226: ina226@41 {
		compatible = "ti,ina226";
		reg = <0x41>;
		zephyr,deferred-init;
		rshunt-micro-ohms = <500>;
		current-lsb-microamps = <5000>;
		avg-count = <64>;
		vbus-conversion-time-us = <588>;
		vshunt-conversion-time-us = <588>;
	};

	power1_ina228: ina228@45 {
		compatible = "ti,ina228";
		reg = <0x45>;
		zephyr,deferred-init;
		rshunt-micro-ohms = <500>;
		current-lsb-microamps = <625>;
	};

	power1_sbs: sbs-gauge@b {
		compatible = "sbs,sbs-gauge-new-api";
		reg = <0xb>;
		zephyr,deferred-init;
	};
};

/*
 * digital power modules on POWER1 and POWER2, with the shunts and current ranges of the
 * INA226_* and INA228_* parameters, and the smart battery on POWER2
 */
&lpi2c2 {
	power2_ina226: ina226@41 {
		compatible = "ti,ina226";
		reg = <0x41>;
		zephyr,deferred-init;
		rshunt-micro-ohms = <500>;
		current-lsb-microamps = <5000>;
		avg-count = <64>;
		vbus-conversion-time-us = <588>;
		vshunt-conversion-time-us = <588>;
	};

	power2_ina228: ina228@45 {
		compatible = "ti,ina228";
		reg = <0x45>;
		zephyr,deferred-init;
		rshunt-micro-ohms = <500>;
		current-lsb-microamps = <625>;
	};

	power2_sbs: sbs-gauge@b {
		compatible = "sbs,sbs-gauge-new-api";
		reg = <0xb>;
		zephyr,deferred-init;
	};
};

&ist8310 {
	zephyr,deferred-init;
};

&zephyr_udc0 {
	phy-handle = <&usbphy1>;

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* calibration of the MIMXRT1170-EVK */
&usbphy1 {
	status = "okay";
	tx-d-cal = <7>;
	tx-cal-45-dp-ohms = <6>;
	tx-cal-45-dm-ohms = <6>;
};
