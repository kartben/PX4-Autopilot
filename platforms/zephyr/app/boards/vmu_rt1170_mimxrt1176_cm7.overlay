/*
 * VMU RT1170 with a Holybro M10 GPS on GPS1 (--shield holybro_m10), sensor orientation and serial
 * ports as in boards/px4/fmu-v6xrt/init/rc.board_sensors, the SD card and CAN buses
 */

#include <dt-bindings/px4/rotation.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/mcux-lpadc.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/sensor/icm42686.h>
#include <zephyr/dt-bindings/sensor/icm42688.h>

/ {
	px4-sensors {
		compatible = "px4,sensors";

		imu0 {
			sensor = <&icm42686_0>;
			type = "imu";
			rotation = <PX4_ROTATION_PITCH_180>;
		};

		imu1 {
			sensor = <&icm42688_0>;
			type = "imu";
			rotation = <PX4_ROTATION_YAW_270>;
		};

		accel2 {
			sensor = <&bmi08x_accel>;
			type = "accel";
			rotation = <PX4_ROTATION_YAW_180>;
		};

		gyro2 {
			sensor = <&bmi08x_gyro>;
			type = "gyro";
			rotation = <PX4_ROTATION_YAW_180>;
		};

		mag0 {
			sensor = <&holybro_m10_mag>;
			type = "mag";
			rotation = <PX4_ROTATION_ROLL_180_YAW_90>;
			external;
		};

		mag1 {
			sensor = <&bmm150>;
			type = "mag";
		};

		mag2 {
			sensor = <&rm3100>;
			type = "mag";
			external;
		};

		mag3 {
			sensor = <&lis3mdl>;
			type = "mag";
			external;
		};

		baro0 {
			sensor = <&bmp388_0>;
			type = "baro";
		};

		baro1 {
			sensor = <&bmp388_1>;
			type = "baro";
		};

		power1-ina226 {
			sensor = <&power1_ina226>;
			type = "power";
			battery = <1>;
		};

		power1-ina228 {
			sensor = <&power1_ina228>;
			type = "power";
			battery = <1>;
		};

		power2-ina226 {
			sensor = <&power2_ina226>;
			type = "power";
			battery = <2>;
		};

		power2-ina228 {
			sensor = <&power2_ina228>;
			type = "power";
			battery = <2>;
		};

		power1-smart-battery {
			sensor = <&power1_sbs>;
			type = "fuel-gauge";
			battery = <1>;
		};

		power2-smart-battery {
			sensor = <&power2_sbs>;
			type = "fuel-gauge";
			battery = <2>;
		};
	};

	px4-serial-ports {
		compatible = "px4,serial-ports";

		gps1 {
			uart = <&pixhawk_full_gps1_serial>;
			path = "/dev/ttyS1";
		};

		telem1 {
			uart = <&pixhawk_telem1>;
			path = "/dev/ttyS2";
		};

		gps2 {
			uart = <&pixhawk_gps2_serial>;
			path = "/dev/ttyS3";
		};

		telem2 {
			uart = <&pixhawk_telem2>;
			path = "/dev/ttyS5";
		};

		telem3 {
			uart = <&lpuart10>;
			path = "/dev/ttyS6";
		};

		ext2 {
			uart = <&lpuart11>;
			path = "/dev/ttyS7";
		};

		usb {
			uart = <&cdc_acm_uart0>;
			path = "/dev/ttyACM0";
		};
	};

	px4-can-buses {
		compatible = "px4,can-buses";

		can1 {
			can = <&flexcan1>;
		};

		can2 {
			can = <&flexcan2>;
		};

		can3 {
			can = <&flexcan3>;
		};
	};

	/*
	 * FMU_CH1 to FMU_CH8 of FMU-v6XRT (boards/px4/fmu-v6xrt/src/timer_config.cpp), at 400 Hz. The
	 * nxp,prescaler of the board limits the period to 17 ms.
	 */
	px4-pwm-outputs {
		compatible = "px4,pwm-outputs";

		main1 {
			pwms = <&flexpwm1_pwm0 0 PWM_HZ(400) PWM_POLARITY_NORMAL>;
		};

		main2 {
			pwms = <&flexpwm1_pwm1 0 PWM_HZ(400) PWM_POLARITY_NORMAL>;
		};

		main3 {
			pwms = <&flexpwm1_pwm2 0 PWM_HZ(400) PWM_POLARITY_NORMAL>;
		};

		main4 {
			pwms = <&flexpwm2_pwm0 0 PWM_HZ(400) PWM_POLARITY_NORMAL>;
		};

		main5 {
			pwms = <&flexpwm2_pwm1 0 PWM_HZ(400) PWM_POLARITY_NORMAL>;
		};

		main6 {
			pwms = <&flexpwm2_pwm2 0 PWM_HZ(400) PWM_POLARITY_NORMAL>;
		};

		main7 {
			pwms = <&flexpwm2_pwm3 0 PWM_HZ(400) PWM_POLARITY_NORMAL>;
		};

		main8 {
			pwms = <&flexpwm3_pwm0 0 PWM_HZ(400) PWM_POLARITY_NORMAL>;
		};
	};

	/*
	 * the board LEDs of FMU-v6XRT, and the LED of the safety switch and the RGB LED of the GPS module
	 */
	px4-leds {
		compatible = "px4,leds";
		blue = <&blue_led>;
		red = <&red_led>;
		green = <&green_led>;
		safety = <&holybro_m10_safety_led>;
		rgb = <&gnss_led>;
	};

	/* the safety switch of the GPS module */
	px4-safety-button {
		compatible = "px4,safety-button";
		button = <&holybro_m10_safety_switch>;
	};

	/*
	 * the ADC channels of FMU-v6XRT (boards/px4/fmu-v6xrt/src/board_config.h), in the order of their
	 * channel numbers with NuttX, 4 to 11: the 3.3 V rails of the sensors, the 5 V rail and the
	 * inputs of the ADC connector
	 */
	px4-adc {
		compatible = "px4,adc";
		io-channels = <&lpadc1 0>, <&lpadc1 1>, <&lpadc1 2>, <&lpadc1 3>, <&lpadc1 4>, <&lpadc1 5>,
			      <&lpadc1 6>;
		io-channel-names = "scaled-vdd-3v3-sensors1", "scaled-vdd-3v3-sensors2",
				   "scaled-vdd-3v3-sensors3", "scaled-v5", "adc-6v6", "adc-3v3",
				   "scaled-vdd-3v3-sensors4";
	};

	fstab {
		compatible = "zephyr,fstab";

		sd {
			compatible = "zephyr,fstab,fatfs";
			mount-point = "/SD:";
			automount;
			disk-access;
		};
	};
};

/*
 * the output data rates and full scales of the IMU drivers of FMU-v6XRT: 8 kHz for the ICM-4268x,
 * whose FIFO watermark the zephyr_sensors driver sets for IMU_GYRO_RATEMAX, 1600 Hz for the
 * accelerometer of the BMI088 and 2000 Hz for its gyroscope, with FIFO watermarks for the default
 * IMU_GYRO_RATEMAX, 400 Hz
 */
&icm42686_0 {
	accel-odr = <ICM42686_DT_ACCEL_ODR_8000>;
	accel-fs = <ICM42686_DT_ACCEL_FS_32>;
	gyro-odr = <ICM42686_DT_GYRO_ODR_8000>;
	gyro-fs = <ICM42686_DT_GYRO_FS_4000>;
};

&icm42688_0 {
	accel-odr = <ICM42688_DT_ACCEL_ODR_8000>;
	gyro-odr = <ICM42688_DT_GYRO_ODR_8000>;
};

&bmi08x_accel {
	accel-hz = "1600";
	fifo-watermark = <4>;
};

&bmi08x_gyro {
	gyro-hz = "2000_532";
	gyro-fs = <2000>;
	fifo-watermark = <5>;
};

/* the RC receiver is on TELEM1, read by the crsf_rc driver, instead of the SBUS input */
&lpuart6 {
	/delete-node/ sbus;
	status = "disabled";
};

/*
 * compasses of GPS modules on GPS1, and the power module or smart battery on POWER1, used if
 * they respond
 */
&lpi2c1 {
	rm3100: rm3100@20 {
		compatible = "pni,rm3100";
		reg = <0x20>;
		zephyr,deferred-init;
	};

	lis3mdl: lis3mdl@1e {
		compatible = "st,lis3mdl-magn";
		reg = <0x1e>;
		zephyr,deferred-init;
	};

	power1_ina226: ina226@41 {
		compatible = "ti,ina226";
		reg = <0x41>;
		zephyr,deferred-init;
		rshunt-micro-ohms = <500>;
		current-lsb-microamps = <5000>;
		avg-count = <64>;
		vbus-conversion-time-us = <588>;
		vshunt-conversion-time-us = <588>;
	};

	power1_ina228: ina228@45 {
		compatible = "ti,ina228";
		reg = <0x45>;
		zephyr,deferred-init;
		rshunt-micro-ohms = <500>;
		current-lsb-microamps = <625>;
	};

	power1_sbs: sbs-gauge@b {
		compatible = "sbs,sbs-gauge-new-api";
		reg = <0xb>;
		zephyr,deferred-init;
	};
};

/*
 * digital power modules on POWER1 and POWER2, with the shunts and current ranges of the
 * INA226_* and INA228_* parameters, and the smart battery on POWER2
 */
&lpi2c2 {
	power2_ina226: ina226@41 {
		compatible = "ti,ina226";
		reg = <0x41>;
		zephyr,deferred-init;
		rshunt-micro-ohms = <500>;
		current-lsb-microamps = <5000>;
		avg-count = <64>;
		vbus-conversion-time-us = <588>;
		vshunt-conversion-time-us = <588>;
	};

	power2_ina228: ina228@45 {
		compatible = "ti,ina228";
		reg = <0x45>;
		zephyr,deferred-init;
		rshunt-micro-ohms = <500>;
		current-lsb-microamps = <625>;
	};

	power2_sbs: sbs-gauge@b {
		compatible = "sbs,sbs-gauge-new-api";
		reg = <0xb>;
		zephyr,deferred-init;
	};
};

&holybro_m10_mag {
	zephyr,deferred-init;
};

/*
 * the LEDs of FMU-v6XRT are active low and open drain (boards/px4/fmu-v6xrt/src/board_config.h), but
 * the board devicetree has the green one active high
 */
&green_led {
	gpios = <&gpio5 2 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
};

&red_led {
	gpios = <&gpio5 1 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
};

&blue_led {
	gpios = <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
};

/* this barometer reads the chip ID of a BMP390, 0x60, which the board devicetree has as a BMP388 */
&bmp388_0 {
	compatible = "bosch,bmp390";
};

/* the IS31FL3195 of the GPS module, used if it responds */
&holybro_m10_rgb_led {
	zephyr,deferred-init;

	gnss_led: led_0 {
	};
};

&pinctrl {
	pinmux_px4_lpadc1: pinmux_px4_lpadc1 {
		group0 {
			pinmux = <&iomuxc_gpio_ad_10_adc1_ch2a>,
				 <&iomuxc_gpio_ad_11_adc1_ch2b>,
				 <&iomuxc_gpio_ad_12_adc1_ch3a>,
				 <&iomuxc_gpio_ad_13_adc1_ch3b>,
				 <&iomuxc_gpio_ad_14_adc1_ch4a>,
				 <&iomuxc_gpio_ad_16_adc1_ch5a>,
				 <&iomuxc_gpio_ad_17_adc1_ch5b>;
			drive-strength = "normal";
			slew-rate = "slow";
		};
	};
};

/*
 * the channels of FMU-v6XRT on LPADC1, with the reference (REFSEL option 1), sample time (131 ADC
 * clocks) and resolution of NuttX. The LPADC scales the inputs by 30/64, which the Zephyr ADC API
 * takes as the 1/2 gain: the 1825 mV reference of NuttX is given as 1825 * 64 / 60 mV, for the
 * full scale of 3.893 V of NuttX (BOARD_ADC_POS_REF_V).
 */
&lpadc1 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&pinmux_px4_lpadc1>;
	pinctrl-names = "default";
	voltage-ref = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_2";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <1947>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 131)>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <MCUX_LPADC_CH2A>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_2";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <1947>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 131)>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <MCUX_LPADC_CH2B>;
	};

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1_2";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <1947>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 131)>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <MCUX_LPADC_CH3A>;
	};

	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1_2";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <1947>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 131)>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <MCUX_LPADC_CH3B>;
	};

	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1_2";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <1947>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 131)>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <MCUX_LPADC_CH4A>;
	};

	channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1_2";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <1947>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 131)>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <MCUX_LPADC_CH5A>;
	};

	channel@6 {
		reg = <6>;
		zephyr,gain = "ADC_GAIN_1_2";
		zephyr,reference = "ADC_REF_EXTERNAL0";
		zephyr,vref-mv = <1947>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 131)>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <MCUX_LPADC_CH5B>;
	};
};

/*
 * LPADC2 senses the hardware version and revision, which PX4 doesn't read on Zephyr, and the pad
 * that the Zephyr board configures for it, GPIO_AD_10, is an input of LPADC1
 */
&lpadc2 {
	status = "disabled";
};

&zephyr_udc0 {
	phy-handle = <&usbphy1>;

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* calibration of the MIMXRT1170-EVK */
&usbphy1 {
	status = "okay";
	tx-d-cal = <7>;
	tx-cal-45-dp-ohms = <6>;
	tx-cal-45-dm-ohms = <6>;
};
