/* Sensor orientation and serial ports as in boards/px4/fmu-v6xrt/init/rc.board_sensors, the SD card and CAN buses */

#include <dt-bindings/px4/rotation.h>

/ {
	px4-sensors {
		compatible = "px4,sensors";

		imu0 {
			sensor = <&icm42686_0>;
			type = "imu";
			rotation = <PX4_ROTATION_PITCH_180>;
		};

		imu1 {
			sensor = <&icm42688_0>;
			type = "imu";
			rotation = <PX4_ROTATION_YAW_270>;
		};

		accel2 {
			sensor = <&bmi08x_accel>;
			type = "accel";
			rotation = <PX4_ROTATION_YAW_180>;
		};

		gyro2 {
			sensor = <&bmi08x_gyro>;
			type = "gyro";
			rotation = <PX4_ROTATION_YAW_180>;
		};

		mag0 {
			sensor = <&ist8310>;
			type = "mag";
			rotation = <PX4_ROTATION_ROLL_180_YAW_90>;
			external;
		};

		mag1 {
			sensor = <&bmm150>;
			type = "mag";
		};

		mag2 {
			sensor = <&rm3100>;
			type = "mag";
			external;
		};

		mag3 {
			sensor = <&lis3mdl>;
			type = "mag";
			external;
		};

		baro0 {
			sensor = <&bmp388_0>;
			type = "baro";
		};

		baro1 {
			sensor = <&bmp388_1>;
			type = "baro";
		};

		power1-ina226 {
			sensor = <&power1_ina226>;
			type = "power";
			battery = <1>;
		};

		power1-ina228 {
			sensor = <&power1_ina228>;
			type = "power";
			battery = <1>;
		};

		power2-ina226 {
			sensor = <&power2_ina226>;
			type = "power";
			battery = <2>;
		};

		power2-ina228 {
			sensor = <&power2_ina228>;
			type = "power";
			battery = <2>;
		};
	};

	/* lpuart6 is the RC input, read by the futaba,sbus input driver */
	px4-serial-ports {
		compatible = "px4,serial-ports";

		gps1 {
			uart = <&lpuart3>;
			path = "/dev/ttyS1";
		};

		telem1 {
			uart = <&lpuart4>;
			path = "/dev/ttyS2";
		};

		gps2 {
			uart = <&lpuart5>;
			path = "/dev/ttyS3";
		};

		telem2 {
			uart = <&lpuart8>;
			path = "/dev/ttyS5";
		};

		telem3 {
			uart = <&lpuart10>;
			path = "/dev/ttyS6";
		};

		ext2 {
			uart = <&lpuart11>;
			path = "/dev/ttyS7";
		};

		usb {
			uart = <&cdc_acm_uart0>;
			path = "/dev/ttyACM0";
		};
	};

	px4-can-buses {
		compatible = "px4,can-buses";

		can1 {
			can = <&flexcan1>;
		};

		can2 {
			can = <&flexcan2>;
		};

		can3 {
			can = <&flexcan3>;
		};
	};

	fstab {
		compatible = "zephyr,fstab";

		sd {
			compatible = "zephyr,fstab,fatfs";
			mount-point = "/SD:";
			automount;
			disk-access;
		};
	};
};

/* compasses of GPS modules on GPS1 and the power module on POWER1, used if they respond */
&lpi2c1 {
	rm3100: rm3100@20 {
		compatible = "pni,rm3100";
		reg = <0x20>;
		zephyr,deferred-init;
	};

	lis3mdl: lis3mdl@1e {
		compatible = "st,lis3mdl-magn";
		reg = <0x1e>;
		zephyr,deferred-init;
	};

	power1_ina226: ina226@41 {
		compatible = "ti,ina226";
		reg = <0x41>;
		zephyr,deferred-init;
		rshunt-micro-ohms = <500>;
		current-lsb-microamps = <5000>;
		avg-count = <64>;
		vbus-conversion-time-us = <588>;
		vshunt-conversion-time-us = <588>;
	};

	power1_ina228: ina228@45 {
		compatible = "ti,ina228";
		reg = <0x45>;
		zephyr,deferred-init;
		rshunt-micro-ohms = <500>;
		current-lsb-microamps = <625>;
	};
};

/*
 * digital power modules on POWER1 and POWER2, with the shunts and current ranges of the
 * INA226_* and INA228_* parameters
 */
&lpi2c2 {
	power2_ina226: ina226@41 {
		compatible = "ti,ina226";
		reg = <0x41>;
		zephyr,deferred-init;
		rshunt-micro-ohms = <500>;
		current-lsb-microamps = <5000>;
		avg-count = <64>;
		vbus-conversion-time-us = <588>;
		vshunt-conversion-time-us = <588>;
	};

	power2_ina228: ina228@45 {
		compatible = "ti,ina228";
		reg = <0x45>;
		zephyr,deferred-init;
		rshunt-micro-ohms = <500>;
		current-lsb-microamps = <625>;
	};
};

&ist8310 {
	zephyr,deferred-init;
};

&zephyr_udc0 {
	phy-handle = <&usbphy1>;

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* calibration of the MIMXRT1170-EVK */
&usbphy1 {
	status = "okay";
	tx-d-cal = <7>;
	tx-cal-45-dp-ohms = <6>;
	tx-cal-45-dm-ohms = <6>;
};
