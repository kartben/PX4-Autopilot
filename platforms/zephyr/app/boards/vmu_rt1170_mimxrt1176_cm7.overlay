/* Sensor orientation and serial ports as in boards/px4/fmu-v6xrt/init/rc.board_sensors, and the SD card */

#include <dt-bindings/px4/rotation.h>

/ {
	px4-sensors {
		compatible = "px4,sensors";

		imu0 {
			sensor = <&icm42686_0>;
			type = "imu";
			rotation = <PX4_ROTATION_PITCH_180>;
		};

		imu1 {
			sensor = <&icm42688_0>;
			type = "imu";
			rotation = <PX4_ROTATION_YAW_270>;
		};

		accel2 {
			sensor = <&bmi08x_accel>;
			type = "accel";
			rotation = <PX4_ROTATION_YAW_180>;
		};

		gyro2 {
			sensor = <&bmi08x_gyro>;
			type = "gyro";
			rotation = <PX4_ROTATION_YAW_180>;
		};

		mag0 {
			sensor = <&ist8310>;
			type = "mag";
			rotation = <PX4_ROTATION_ROLL_180_YAW_90>;
			external;
		};

		mag1 {
			sensor = <&bmm150>;
			type = "mag";
		};

		baro0 {
			sensor = <&bmp388_0>;
			type = "baro";
		};

		baro1 {
			sensor = <&bmp388_1>;
			type = "baro";
		};
	};

	/* lpuart6 is the RC input, read by the futaba,sbus input driver */
	px4-serial-ports {
		compatible = "px4,serial-ports";

		gps1 {
			uart = <&lpuart3>;
			path = "/dev/ttyS1";
		};

		telem1 {
			uart = <&lpuart4>;
			path = "/dev/ttyS2";
		};

		gps2 {
			uart = <&lpuart5>;
			path = "/dev/ttyS3";
		};

		telem2 {
			uart = <&lpuart8>;
			path = "/dev/ttyS5";
		};

		telem3 {
			uart = <&lpuart10>;
			path = "/dev/ttyS6";
		};

		ext2 {
			uart = <&lpuart11>;
			path = "/dev/ttyS7";
		};

		usb {
			uart = <&cdc_acm_uart0>;
			path = "/dev/ttyACM0";
		};
	};

	fstab {
		compatible = "zephyr,fstab";

		sd {
			compatible = "zephyr,fstab,fatfs";
			mount-point = "/SD:";
			automount;
			disk-access;
		};
	};
};

&zephyr_udc0 {
	phy-handle = <&usbphy1>;

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* calibration of the MIMXRT1170-EVK */
&usbphy1 {
	status = "okay";
	tx-d-cal = <7>;
	tx-cal-45-dp-ohms = <6>;
	tx-cal-45-dm-ohms = <6>;
};
