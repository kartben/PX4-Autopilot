/* USB serial port on USB OTG1, CRSF receiver on the Arduino UART, the microSD card, the CAN bus
 * and the user LEDs of the MIMXRT1170-EVK
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	chosen {
		zephyr,sram = &ocram;
	};

	px4-serial-ports {
		compatible = "px4,serial-ports";

		usb {
			uart = <&cdc_acm_uart0>;
			path = "/dev/ttyACM0";
		};
	};

	/* the 16 channels of the CRSF receiver, in order */
	px4-rc-input {
		compatible = "px4,rc-input";
		input = <&crsf>;
		channels = <INPUT_EV_MSC 1>, <INPUT_EV_MSC 2>, <INPUT_EV_MSC 3>, <INPUT_EV_MSC 4>,
			   <INPUT_EV_MSC 5>, <INPUT_EV_MSC 6>, <INPUT_EV_MSC 7>, <INPUT_EV_MSC 8>,
			   <INPUT_EV_MSC 9>, <INPUT_EV_MSC 10>, <INPUT_EV_MSC 11>, <INPUT_EV_MSC 12>,
			   <INPUT_EV_MSC 13>, <INPUT_EV_MSC 14>, <INPUT_EV_MSC 15>, <INPUT_EV_MSC 16>;
		/* the driver gives the pulse widths */
		input-min = <1000>;
		input-max = <2000>;
	};

	px4-can-buses {
		compatible = "px4,can-buses";

		can1 {
			can = <&flexcan3>;
		};
	};

	px4-leds {
		compatible = "px4,leds";
		red = <&red_led>;
		green = <&green_led>;
	};

	fstab {
		compatible = "zephyr,fstab";

		sd {
			compatible = "zephyr,fstab,fatfs";
			mount-point = "/SD:";
			automount;
			disk-access;
		};
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* ExpressLRS or Crossfire receiver on Arduino D0 (RX) and D1 (TX), without the RTS and CTS of the
 * M.2 Bluetooth module of the EVKB
 */
&lpuart2 {
	pinctrl-0 = <&pinmux_lpuart2>;
	status = "okay";

	crsf: crsf {
		compatible = "tbs,crsf";

		ch1 {
			channel = <1>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <1>;
		};

		ch2 {
			channel = <2>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <2>;
		};

		ch3 {
			channel = <3>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <3>;
		};

		ch4 {
			channel = <4>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <4>;
		};

		ch5 {
			channel = <5>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <5>;
		};

		ch6 {
			channel = <6>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <6>;
		};

		ch7 {
			channel = <7>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <7>;
		};

		ch8 {
			channel = <8>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <8>;
		};

		ch9 {
			channel = <9>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <9>;
		};
		ch10 {
			channel = <10>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <10>;
		};

		ch11 {
			channel = <11>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <11>;
		};

		ch12 {
			channel = <12>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <12>;
		};

		ch13 {
			channel = <13>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <13>;
		};

		ch14 {
			channel = <14>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <14>;
		};

		ch15 {
			channel = <15>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <15>;
		};

		ch16 {
			channel = <16>;
			type = <INPUT_EV_MSC>;
			zephyr,code = <16>;
		};
	};
};

/* in 1.8 V signalling, the SD card often fails to initialize after a warm reset */
&usdhc1 {
	no-1-8-v;
};

/* RAM in the OCRAM of the M4, OCRAM1 and half of OCRAM2, 1 MiB in one MPU region, instead of the
 * slower SDRAM
 */
&ocram {
	reg = <0x20200000 DT_SIZE_M(1)>;
};

/* the GPIO ports that nothing uses */
&gpio1 {
	status = "disabled";
};

&gpio3 {
	status = "disabled";
};

&gpio4 {
	status = "disabled";
};

&gpio7 {
	status = "disabled";
};

&fgpio2 {
	status = "disabled";
};

&fgpio3 {
	status = "disabled";
};
