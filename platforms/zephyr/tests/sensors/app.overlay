#include <dt-bindings/px4/rotation.h>

/ {
	spi_emul: spi@b0000000 {
		compatible = "zephyr,spi-emul-controller";
		reg = <0xb0000000 0x100>;
		clock-frequency = <50000000>;
		#address-cells = <1>;
		#size-cells = <0>;

		icm42688: icm42688@0 {
			compatible = "invensense,icm42688", "invensense,icm4268x";
			reg = <0>;
			spi-max-frequency = <24000000>;
		};
	};

	i2c_emul: i2c@b0000100 {
		compatible = "zephyr,i2c-emul-controller";
		reg = <0xb0000100 0x100>;
		clock-frequency = <400000>;
		#address-cells = <1>;
		#size-cells = <0>;

		akm09918c: akm09918c@c {
			compatible = "asahi-kasei,akm09918c";
			reg = <0xc>;
			zephyr,deferred-init;
		};

		/* no emulator: the sensor doesn't respond */
		ist8310: ist8310@e {
			compatible = "isentek,ist8310";
			reg = <0xe>;
			zephyr,deferred-init;
		};
	};

	baro: baro {
		compatible = "vnd,baro";
	};

	px4-sensors {
		compatible = "px4,sensors";

		imu0 {
			sensor = <&icm42688>;
			type = "imu";
			rotation = <PX4_ROTATION_YAW_90>;
		};

		mag0 {
			sensor = <&akm09918c>;
			type = "mag";
			external;
		};

		mag1 {
			sensor = <&ist8310>;
			type = "mag";
			external;
		};

		baro0 {
			sensor = <&baro>;
			type = "baro";
		};
	};
};
