#include <dt-bindings/px4/rotation.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/sensor/icm42688.h>

/ {
	gpio_emul: gpio-emul {
		compatible = "zephyr,gpio-emul";
		gpio-controller;
		#gpio-cells = <2>;
		rising-edge;
	};

	spi_emul: spi@b0000000 {
		compatible = "zephyr,spi-emul-controller";
		reg = <0xb0000000 0x100>;
		clock-frequency = <50000000>;
		#address-cells = <1>;
		#size-cells = <0>;

		/* its FIFO is streamed at 8 kHz, with 20-bit samples, as on the NXP VMU RT1170 */
		icm42688: icm42688@0 {
			compatible = "invensense,icm42688", "invensense,icm4268x";
			reg = <0>;
			spi-max-frequency = <24000000>;
			int-gpios = <&gpio_emul 0 GPIO_ACTIVE_HIGH>;
			accel-pwr-mode = <ICM42688_DT_ACCEL_LN>;
			accel-odr = <ICM42688_DT_ACCEL_ODR_8000>;
			accel-fs = <ICM42688_DT_ACCEL_FS_16>;
			gyro-pwr-mode = <ICM42688_DT_GYRO_LN>;
			gyro-odr = <ICM42688_DT_GYRO_ODR_8000>;
			gyro-fs = <ICM42688_DT_GYRO_FS_2000>;
			fifo-hires;
		};

		/* its interrupt pin doesn't pulse: it is polled */
		icm42688_polled: icm42688@1 {
			compatible = "invensense,icm42688", "invensense,icm4268x";
			reg = <1>;
			spi-max-frequency = <24000000>;
			int-gpios = <&gpio_emul 1 GPIO_ACTIVE_HIGH>;
			accel-pwr-mode = <ICM42688_DT_ACCEL_LN>;
			accel-odr = <ICM42688_DT_ACCEL_ODR_1000>;
			accel-fs = <ICM42688_DT_ACCEL_FS_16>;
			gyro-pwr-mode = <ICM42688_DT_GYRO_LN>;
			gyro-odr = <ICM42688_DT_GYRO_ODR_1000>;
			gyro-fs = <ICM42688_DT_GYRO_FS_2000>;
		};
	};

	i2c_emul: i2c@b0000100 {
		compatible = "zephyr,i2c-emul-controller";
		reg = <0xb0000100 0x100>;
		clock-frequency = <400000>;
		#address-cells = <1>;
		#size-cells = <0>;

		akm09918c: akm09918c@c {
			compatible = "asahi-kasei,akm09918c";
			reg = <0xc>;
			zephyr,deferred-init;
		};

		sbs_gauge: sbs-gauge@b {
			compatible = "sbs,sbs-gauge-new-api";
			reg = <0xb>;
			zephyr,deferred-init;
		};

		/* no emulator: the sensor doesn't respond */
		ist8310: ist8310@e {
			compatible = "isentek,ist8310";
			reg = <0xe>;
			zephyr,deferred-init;
		};
	};

	baro: baro {
		compatible = "vnd,baro";
	};

	power_monitor: power-monitor {
		compatible = "vnd,power-monitor";
	};

	px4-sensors {
		compatible = "px4,sensors";

		imu0 {
			sensor = <&icm42688>;
			type = "imu";
			rotation = <PX4_ROTATION_YAW_90>;
		};

		imu1 {
			sensor = <&icm42688_polled>;
			type = "imu";
			rotation = <PX4_ROTATION_YAW_90>;
		};

		mag0 {
			sensor = <&akm09918c>;
			type = "mag";
			external;
		};

		mag1 {
			sensor = <&ist8310>;
			type = "mag";
			external;
		};

		baro0 {
			sensor = <&baro>;
			type = "baro";
		};

		power0 {
			sensor = <&power_monitor>;
			type = "power";
			battery = <2>;
		};

		fuel-gauge0 {
			sensor = <&sbs_gauge>;
			type = "fuel-gauge";
		};
	};
};
