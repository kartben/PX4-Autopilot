# Ground station on the USB OTG1 port, see platforms/zephyr/app/boards/mimxrt1170_evk_mimxrt1176_cm7.overlay
ver all
load_mon start
zephyr_sensors start
sensors start
# ExpressLRS or Crossfire receiver on the Arduino UART, see platforms/zephyr/app/boards/mimxrt1170_evk_mimxrt1176_cm7.overlay
crsf_rc start -d /dev/ttyS1
# MAVLink on the USB OTG1 port, while a ground station has it open
cdcacm_autostart start
mavlink boot_complete
